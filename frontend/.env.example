# Where the SADEED API (backend/, Laravel) lives. Copy this file to .env.
#
# Local development: the Laravel server started with `php artisan serve`.
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Production: the API's public address, e.g.
# VITE_API_URL=https://api.example.com/api/v1
#
# The API must allow this app's address: set CORS_ALLOWED_ORIGINS in
# backend/.env to wherever this app is served from.
